lector((state) => state.toggle_header);\r\n\r\n    const renderRefreshTooltip = (props) => (\r\n        <Tooltip id=\"refresh-tooltip\" {...props}>\r\n            Refresh\r\n        </Tooltip>\r\n    );\r\n    const renderCollapseTooltip = (props) => (\r\n        <Tooltip id=\"refresh-tooltip\" {...props}>\r\n            Collapse\r\n        </Tooltip>\r\n    )\r\n    return (\r\n        <div>\r\n            <div className=\"page-wrapper\">\r\n                <div className=\"content settings-content\">\r\n                    <div className=\"page-header settings-pg-header\">\r\n                        <div className=\"add-item d-flex\">\r\n                            <div className=\"page-title\">\r\n                                <h4>Settings</h4>\r\n                                <h6>Manage your settings on portal</h6>\r\n                            </div>\r\n                        </div>\r\n                        <ul className=\"table-top-head\">\r\n                            <li>\r\n                                <OverlayTrigger placement=\"top\" overlay={renderRefreshTooltip}>\r\n\r\n                                    <Link data-bs-toggle=\"tooltip\" data-bs-placement=\"top\">\r\n                                        <RotateCcw />\r\n                                    </Link>\r\n                                </OverlayTrigger>\r\n                            </li>\r\n                            <li>\r\n                                <OverlayTrigger placement=\"top\" overlay={renderCollapseTooltip}>\r\n\r\n                                    <Link\r\n                                        data-bs-toggle=\"tooltip\"\r\n                                        data-bs-placement=\"top\"\r\n                                        id=\"collapse-header\"\r\n                                        className={data ? \"active\" : \"\"}\r\n                                        onClick={() => {dispatch(setToogleHeader(!data)) }}\r\n                                    >\r\n                                        <ChevronUp />\r\n                                    </Link>\r\n                                </OverlayTrigger>\r\n                            </li>\r\n\r\n                        </ul>\r\n                    </div>\r\n                    <div className=\"row\">\r\n                        <div className=\"col-xl-12\">\r\n                            <div className=\"settings-wrapper d-flex\">\r\n                            <SettingsSidebar/>\r\n                                <div className=\"settings-page-wrap\">\r\n                                    <form>\r\n                                        <div className=\"setting-title\">\r\n                                            <h4>Profile Settings</h4>\r\n                                        </div>\r\n                                        <div className=\"card-title-head\">\r\n                                            <h6>\r\n                                                <span>\r\n                                                    \r\n                                                    <User className=\"feather-chevron-up\"/>\r\n                                                </span>\r\n                                                Employee Information\r\n                                            </h6>\r\n                                        </div>\r\n                                        <div className=\"profile-pic-upload\">\r\n                                            <div className=\"profile-pic\">\r\n                                                <span>\r\n\r\n                                                    <PlusCircle className=\"plus-down-add\"/>\r\n                                                    Profile Photo\r\n                                                </span>\r\n                                            </div>\r\n                                            <div className=\"new-employee-field\">\r\n                                                <div className=\"mb-0\">\r\n                                                    <div className=\"image-upload mb-0\">\r\n                                                        <input type=\"file\" />\r\n                                                        <div className=\"image-uploads\">\r\n                                                            <h4>Change Image</h4>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                    <span>\r\n                                                        For better preview recommended size is 450px x 450px. Max\r\n                                                        size 5MB.\r\n                                                    </span>\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                        <div className=\"row\">\r\n                                            <div className=\"col-md-4\">\r\n                                                <div className=\"mb-3\">\r\n                                                    <label className=\"form-label\">First Name</label>\r\n                                                    <input type=\"text\" className=\"form-control\" />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-md-4\">\r\n                                                <div className=\"mb-3\">\r\n                                                    <label className=\"form-label\">Last Name</label>\r\n                                                    <input type=\"text\" className=\"form-control\" />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-md-4\">\r\n                                                <div className=\"mb-3\">\r\n                                                    <label className=\"form-label\">User Name</label>\r\n                                                    <input type=\"text\" className=\"form-control\" />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-md-4\">\r\n                                                <div className=\"mb-3\">\r\n                                                    <label className=\"form-label\">Phone Number</label>\r\n                                                    <input type=\"text\" className=\"form-control\" />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-md-4\">\r\n                                                <div className=\"mb-3\">\r\n                                                    <label className=\"form-label\">Email</label>\r\n                                                    <input type=\"email\" className=\"form-control\" />\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                        <div className=\"card-title-head\">\r\n                                            <h6>\r\n                                                <span>\r\n                                                    <i data-feather=\"map-pin\" className=\"feather-chevron-up\" />\r\n                                                </span>\r\n                                                Our Address\r\n                                            </h6>\r\n                                        </div>\r\n                                        <div className=\"row\">\r\n                                            <div className=\"col-md-12\">\r\n                                                <div className=\"mb-3\">\r\n                                                    <label className=\"form-label\">Address</label>\r\n                                                    <input type=\"email\" className=\"form-control\" />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-xl-3 col-lg-4 col-md-3\">\r\n                                                <div className=\"mb-3\">\r\n                                                    <label className=\"form-label\">Country</label>\r\n                                                    <input type=\"text\" className=\"form-control\" />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-xl-3 col-lg-4 col-md-3\">\r\n                                                <div className=\"mb-3\">\r\n                                                    <label className=\"form-label\">State / Province</label>\r\n                                                    <input type=\"text\" className=\"form-control\" />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-xl-3 col-lg-4 col-md-3\">\r\n                                                <div className=\"mb-3\">\r\n                                                    <label className=\"form-label\">City</label>\r\n                                                    <input type=\"text\" className=\"form-control\" />\r\n                                                
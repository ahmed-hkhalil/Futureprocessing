editquotation.jsx"],"sourcesContent":["import React, { useState } from 'react'\r\nimport TextEditor from '../../../feature-module/inventory/texteditor'\r\nimport { DatePicker } from 'antd';\r\nimport Select from 'react-select';\r\nimport { Link } from 'react-router-dom';\r\nimport { PlusCircle } from 'feather-icons-react/build/IconComponents';\r\nimport { MinusCircle } from 'react-feather';\r\nimport ImageWithBasePath from '../../img/imagewithbasebath';\r\n\r\nconst EditQuotation = () => {\r\n    const customer = [\r\n        { value: 'Choose', label: 'Choose' },\r\n        { value: 'Thomas', label: 'Thomas' },\r\n        { value: 'Rose', label: 'Rose' },\r\n    ];\r\n    const status = [\r\n        { value: 'Pending', label: 'Pending' },\r\n        { value: 'Completed', label: 'Completed' },\r\n    ];\r\n    const [selectedDate, setSelectedDate] = useState(new Date());\r\n    const handleDateChange = (date) => {\r\n        setSelectedDate(date);\r\n    };\r\n    const [quantity, setQuantity] = useState(4);\r\n\r\n    const handleDecrement = () => {\r\n      if (quantity > 1) {\r\n        setQuantity(quantity - 1);\r\n      }\r\n    };\r\n    const handleIncrement = () => {\r\n      setQuantity(quantity + 1);\r\n    };\r\n    const [quantity1, setQuantity1] = useState(4);\r\n\r\n    const handleDecrement1 = () => {\r\n      if (quantity1 > 1) {\r\n        setQuantity1(quantity - 1);\r\n      }\r\n    };\r\n    const handleIncrement1 = () => {\r\n      setQuantity1(quantity1 + 1);\r\n    };\r\n    const [quantity3, setQuantity3] = useState(4);\r\n\r\n    const handleDecrement3 = () => {\r\n      if (quantity3 > 1) {\r\n        setQuantity3(quantity3 - 1);\r\n      }\r\n    };\r\n    const handleIncrement3 = () => {\r\n      setQuantity3(quantity3 + 1);\r\n    };\r\n    return (\r\n        <div>\r\n            {/* edit popup */}\r\n            <div className=\"modal fade\" id=\"edit-units\">\r\n                <div className=\"modal-dialog edit-sales-modal\">\r\n                    <div className=\"modal-content\">\r\n                        <div className=\"page-wrapper p-0 m-0\">\r\n                            <div className=\"content p-0\">\r\n                                <div className=\"page-header p-4 mb-0\">\r\n                                    <div className=\"add-item new-sale-items d-flex\">\r\n                                        <div className=\"page-title\">\r\n                                            <h4>Edit Quotation</h4>\r\n                                        </div>\r\n                                        <button\r\n                                            type=\"button\"\r\n                                            className=\"close\"\r\n                                            data-bs-dismiss=\"modal\"\r\n                                            aria-label=\"Close\"\r\n                                        >\r\n                                            <span aria-hidden=\"true\">×</span>\r\n                                        </button>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"card\">\r\n                                    <div className=\"card-body\">\r\n                                        <form>\r\n                                            <div className=\"row\">\r\n                                                <div className=\"col-lg-4 col-sm-6 col-12\">\r\n                                                    <div className=\"input-blocks\">\r\n                                                        <label>Customer Name</label>\r\n                                                        <div className=\"row\">\r\n                                                            <div className=\"col-lg-10 col-sm-10 col-10\">\r\n\r\n                                                                <Select\r\n                                                                    className=\"select\"\r\n                                                                    options={customer}\r\n                                                                    placeholder=\"Choose Brand\"\r\n                                                                />\r\n                                                            </div>\r\n                                                            <div className=\"col-lg-2 col-sm-2 col-2 ps-0\">\r\n                                                                <div className=\"add-icon\">\r\n                                                                    <span className=\"choose-add\">\r\n                                                                      \r\n                                                                        <PlusCircle className=\"plus\"/>\r\n                                                                    </span>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                                <div className=\"col-lg-4 col-sm-6 col-12\">\r\n                                                    <div className=\"input-blocks\">\r\n                                                        <label>Date</label>\r\n                                                        <div className=\"input-groupicon calender-input\">\r\n                                                            <DatePicker\r\n                                                                selected={selectedDate}\r\n                                                                onChange={handleDateChange}\r\n                                                                type=\"date\"\r\n                                                                className=\"filterdatepicker\"\r\n                                                                dateFormat=\"dd-MM-yyyy\"\r\n                                                                placeholder='Choose Date'\r\n                                                            />\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                                <div className=\"col-lg-4 col-sm-6 col-12\">\r\n                                                    <div className=\"input-blocks\">\r\n                                                        <label>Reference Number</label>\r\n                                                        <input type=\"text\" placeholder={123456} />\r\n                                                    </div>\r\n                                                </div>\r\n                                                <div className=\"col-lg-12 col-sm-6 col-12\">\r\n                                                    <div className=\"input-blocks\">\r\n                                                        <label>Product Name</label>\r\n                                                        <div className=\"input-groupicon select-code\">\r\n                                                            <input\r\n                                                                type=\"text\"\r\n                                                                placeholder=\"Please type product code and select\"\r\n                                                            />\r\n                                                            <div className=\"addonset\">\r\n                                                               <ImageWithBasePath\r\n                                                                    src=\"assets/img/icons/scanners.svg\"\r\n                                                                    alt=\"img\"\r\n                                                                />\r\n                                                            </div>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"table-responsive no-pagination\">\r\n                                                <table className=\"table  datanew\">\r\n                                                    <thead>\r\n                                                        <tr>\r\n                                                            <th>Product</th>\r\n                                                            <th>Qty</th>\r\n                                                            <th>Purchase Price($)</th>\r\n                                                            <th>Discount($)</th>\r\n                                                            <th>Tax(%)</th>\r\n                                                            <th>Tax Amount($)</th>\r\n                                                            <th>Unit Cost($)</th>\r\n                                                            <th>Total Cost(%)</th>\r\n                                                        </tr>\r\n                                                    </thead>\r\n                                                    <tbody>\r\n                                                        <tr>\r\n                                                            <td>\r\n                                                                <div className=\"productimgname\">\r\n                                                                    <Link\r\n                                                                        to=\"#\"\r\n                                                                        className=\"product-img stock-img\"\r\n                                                                    >\r\n                                                                       <ImageWithBasePath\r\n                                                                            src=\"assets/img/products/stock-img-02.png\"\r\n                                                                            alt=\"product\"\r\n                                                                        />\r\n                                                                    </Link>\r\n                                                                    <Link to=\"#\">Nike Jordan</Link>\r\n                                                                </div>\r\n                                                            </td>\r\n                                                            <td>\r\n                                                                <div className=\"product-quantity\">\r\n                                                                    <span className=\"quantity-btn\" onClick={handleIncrement}>\r\n                                                                    <PlusCircle className=\"plus-circle\" />\r\n                                                                       \r\n                                                                    </span>\r\n                                                                    <input  value={quantity}\r\n                                                                        type=\"text\"\r\n                                                                        className=\"quntity-input\"\r\n                                                                        defaultValue={2}\r\n                                                                    />\r\n                                                                    <span className=\"quantity-btn\" onClick={handleDecrement}>\r\n                                                                    <MinusCircle />\r\n                                                                    </span>\r\n                                                                </div>\r\n                                                            </td>\r\n                                                            <td>2000</td>\r\n                                                            <td>500</td>\r\n                                                            <td>0.00</td>\r\n                                                            <td>0.00</td>\r\n                                                            <td>0.00</td>\r\n                                                            <td>1500</td>\r\n                                                        </tr>\r\n                                                        <tr>\r\n                                                            <td>\r\n                                                                <div className=\"productimgname\">\r\n                                                                    <Link\r\n                                                                        to=\"#\"\r\n                                                                        className=\"product-img stock-img\"\r\n                                                                    >\r\n                                                                       <ImageWithBasePath\r\n                                                                            src=\"assets/img/products/stock-img-03.png\"\r\n                                                                            alt=\"product\"\r\n                                                                        />\r\n                                                                    </Link>\r\n                             